generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ARTIST
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  surname       String
  username      String   @unique
  email         String   @unique
  emailVerified Boolean  @default(false)
  password      String
  role          Role     @default(USER)
  photo         String?
  bio           String?
  createdAt     DateTime @default(now())

  albums     Album[]
  songs      Song[]
  playlists  Playlist[]
  favArtists FavArtist[] @relation("UserFavArtists")
  fans       FavArtist[] @relation("ArtistFans")
  favSongs   FavSong[]
}

model Album {
  id        Int      @id @default(autoincrement())
  artistId  Int
  title     String
  cover     String?
  createdAt DateTime @default(now())

  artist User   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]
}

model Song {
  id          Int      @id @default(autoincrement())
  artistId    Int
  albumId     Int?
  title       String
  durationSec Int
  audioUrl    String
  cover       String?
  createdAt   DateTime @default(now())

  artist    User           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album     Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlists SongPlaylist[]
  fans      FavSong[]
}

model Playlist {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  name      String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  owner User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  songs SongPlaylist[]
}

model SongPlaylist {
  playlistId Int
  songId     Int
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
}

model FavArtist {
  userId    Int
  artistId  Int
  createdAt DateTime @default(now())

  user   User @relation("UserFavArtists", fields: [userId], references: [id], onDelete: Cascade)
  artist User @relation("ArtistFans", fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
}

model FavSong {
  userId    Int
  songId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
}
