PORT=3000
NODE_ENV=development

# URL del front, para CORS y los links de los mails
FRONTEND_URL=http://localhost:5173

# Neon: en Vercel usar la URL con -pooler; para migraciones, la directa
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secretos distintos para cada token (en prod, nuevos y largos)
JWT_SECRET=
JWT_CONFIRM_SECRET=
JWT_FORGOT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail con contraseña de aplicación
EMAIL_USER=
EMAIL_PASS=
